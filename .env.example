# --- Dùng khi chạy `npm run dev` cục bộ ---
# PostgreSQL connection string
DATABASE_URL="postgresql://vitavina:changeme@localhost:5432/vitavina_erp?schema=public"

# Secret used to sign session JWTs — generate with: openssl rand -base64 48
AUTH_SECRET="changeme-generate-a-long-random-string"

# Public app URL (used for links in notifications, etc.)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Chỉ dùng khi chạy bằng docker-compose (deploy Hostinger VPS) ---
POSTGRES_USER=vitavina
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=vitavina_erp

# Tên miền trỏ về VPS, dùng cho Caddy tự cấp SSL. Để "localhost" nếu chưa có domain.
DOMAIN=erp.vitavina.com.vn

# Đặt true CHỈ ở lần deploy đầu tiên để tạo dữ liệu mẫu + tài khoản admin, sau đó đổi lại false.
SEED_ON_START=false
SEED_ADMIN_EMAIL=vitavinaedu@gmail.com
SEED_ADMIN_PASSWORD=changeme-strong-password
